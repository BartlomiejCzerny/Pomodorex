<?xml version="1.0" encoding="UTF-8" ?>
<!--
    AppShell.xaml - definiuje główną strukturę nawigacji w aplikacji Pomodorex
    W tym pliku ustawiamy Shell, który zarządza zakładkami (TabBar) i stronami (ShellContent)
-->
    
<Shell
    x:Class="Pomodorex.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Pomodorex"
    Title="Pomodorex"
    Shell.FlyoutBehavior="Disabled">
    <!--
        Shell.FlyoutBehavior="Disabled" - wyłącza menu typu hamburger (flyout), ponieważ
        aplikacja jest prosta i używa tylko dwóch zakładek.
    -->

    <!-- TabBar - poziomy pasek zakładek u dołu ekranu -->
    <TabBar>

        <!--
            Pierwsza zakładka: Timer Pomodoro
            Title="Timer" - nazwa wyświetlana w zakładce
            Icon - ikona zakładki, różna dla platform: Android/iOS/Mac
            ShellContent - zawartość zakładki, wskazuje MainPage
        -->
        <Tab
            Title="Timer"
            Icon="{OnPlatform 'icon_notes.png', iOS='icon_notes_ios.png', MacCatalyst='icon_notes_ios.png'}">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"/>
        </Tab>

        <!--
            Druga zakładka: O aplikacji
            Title="O aplikacji" - nazwa zakładki
            Icon - ikona zakładki, różna dla platform
            ShellContent - zawartość zakładki, wskazuje AboutPage
        -->
        <Tab
            Title="O aplikacji"
            Icon="{OnPlatform 'icon_about.png', iOS='icon_about_ios.png', MacCatalyst='icon_about_ios.png'}">
            <ShellContent ContentTemplate="{DataTemplate local:AboutPage}"/>
        </Tab>
    </TabBar>
</Shell>