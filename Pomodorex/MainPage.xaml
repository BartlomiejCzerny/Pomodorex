<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pomodorex.MainPage">
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center">
            <Label x:Name="lblTimer" Margin="20" FontSize="50" Text="00:00" HorizontalOptions="Center"/>
            <Button x:Name="btnTimer" WidthRequest="200" Text="Uruchom" Clicked="btnTimer_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
