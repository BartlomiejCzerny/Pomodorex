<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pomodorex.MainPage">
    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center">
            <Label x:Name="lblTimer" FontSize="50" Text="25:00" HorizontalOptions="Center"/>
            <Slider WidthRequest="200" Minimum="1" Maximum="60" Value="25" ValueChanged="OnPomodoroDurationChanged"/>
            <Button x:Name="btnTimer" WidthRequest="200" Text="Uruchom" Margin="20" Clicked="btnTimer_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
